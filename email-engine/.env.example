# === Email Provider ===
# Resend API key — get one at https://resend.com
RESEND_API_KEY=re_your-resend-api-key-here

# === Sender ===
# Verified domain or Resend's default "onboarding@resend.dev"
EMAIL_FROM=reviews@reviewpilot.app

# === Recipient (for demo/testing) ===
DEMO_TO_EMAIL=owner@example.com

# === Logging ===
EMAIL_DEBUG=false