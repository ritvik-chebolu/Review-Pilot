# ============================================================
# ReviewPilot Environment Configuration Template
# Copy this file to .env or configure in your deployment dashboard.
# ============================================================

# Server settings
PORT=3000
JWT_SECRET=your-secure-jwt-signing-secret
APP_URL=http://localhost:3000

# AI Provider Settings (Optional)
# If DEEPSEEK_API_KEY is not set, ReviewPilot uses the built-in template engine.
# DeepSeek API keys can be obtained for free during beta / low-cost trials.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Business Profile OAuth Settings (Required for Google connection)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/dashboard/settings?oauth=google

# Email Service Settings (Required for notification delivery)
# Resend API Key for sending immediate review alerts & digests.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=reviews@reviewpilot.app
EMAIL_DEBUG=true

# Polling service settings
POLL_SECRET=your-secure-polling-trigger-token
MOCK_POLLING=false
