# === AI Providers ===
# OpenAI (primary - used for most review responses)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (fallback - used for negative/urgent reviews)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here

# === Model Selection ===
# Which provider to use as primary: "openai" or "claude"
AI_PRIMARY_PROVIDER=openai

# === Logging ===
# Set to "true" to log all prompt inputs and outputs to console
AI_DEBUG=false